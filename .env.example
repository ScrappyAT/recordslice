# Postgres connection string.
# Run `docker compose up -d` first, then this value works as-is for local development.
# Note: published on host port 5435, not the Postgres default 5432 — chosen to avoid
# colliding with other local Postgres containers (e.g. auth-slice on 5433).
DATABASE_URL="postgresql://recordslice:localdevpassword@localhost:5435/recordslice?schema=public"
